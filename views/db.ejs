<!DOCTYPE html>
<!-- Layout and styling by Gemini, an AI. -->
<%# Layout and styling by Gemini, an AI. %>
<html>
<head>
  <meta charset='utf-8'>
  <title>The Quotations Database</title>
  <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
</head>
<body>
  <div class="w3-container">
    <h1 class="w3-center w3-xxlarge w3-text-blue">The Quotations Database</h1>

    <table class="w3-table-all w3-bordered w3-striped w3-hoverable centered-table">
      <thead>
        <tr class="w3-blue">
          <th class="w3-center">idUsuario</th>
          <th class="w3-center">First Name</th>
          <th class="w3-center">Last Name</th>
          <th class="w3-center">Fecha de Nacimiento</th>
          <th class="w3-center">Email</th>
        </tr>
      </thead>
      <tbody>
        <% for (const row of rows) { %>
          <tr>
            <td class="w3-right-align"><%= row.id_usuario %></td>
            <td class="w3-left-align"><%= row.first_name %></td>
            <td class="w3-left-align"><%= row.last_name %></td>
            <td class="w3-left-align"><%= row.fecha_nacimiento %></td>
            <td class="w3-left-align"><%= row.email %></td>

          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>