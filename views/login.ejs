<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Acceso | CryptoChicks Game</title>
  <link rel="stylesheet" href="/css/login.css">
  <link rel="icon" type="image/png" href="/images/favicon.ico" >
</head>


<body>
  <!-- Contenedor para la imagen de fondo -->
  <div class="background">
    <img src="/images/BG.png" alt="Fondo" />
  </div>

  <header class="waybar">
    <div class="logo">
      <img src="/images/logo.png" alt="CryptoChicks Logo">
    </div>
    <nav class="navbar">
      <div class="menu-toggle" id="menu-toggle">&#9776;</div>
      <div class="nav-buttons" id="nav-buttons">
        <button onclick="location.href='/'">Inicio</button>
        <button onclick="location.href='/info'">Sobre el juego</button>
      </div>
    </nav>
  </header>

  <main class="auth-wrapper">
    <div class="auth-container">
      <div class="auth-tabs">
        <button id="login-tab" class="active-tab">Iniciar Sesión</button>
      </div>

      <div class="auth-box">
        <form action="/login" method="POST">
          <label for="email">Correo</label>
          <input type="email" name="email" id="email" autocomplete="email">

          <label for="password">Contraseña</label>
          <input type="password" name="password" id="password" autocomplete="current-password">
          <button type="submit">Entrar</button>

          <% if (typeof error !== 'undefined') { %>
            <p class="error-message"><%= error %></p>
          <% } %>
        </form>

        <!-- Botón para registrarse -->
        <div class="register-link">
          <p>¿No tienes una cuenta? <a href="/signup">Regístrate aquí</a></p>
        </div>
      </div>
    </div>
  

</body>
</html>
