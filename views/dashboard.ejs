<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard</title>
  <link rel="stylesheet" href="/css/dashboard.css" />
  <link rel="icon" type="image/png" href="/images/favicon.ico">
  <script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>
  <style>
    @media (max-width: 768px) {
      .sidebar { display: none; }
      .sidebar.show { display: flex; }
      .menu-toggle {
        background: none;
        border: none;
        color: white;
        font-size: 24px;
        cursor: pointer;
      }
    }

    @media (max-width: 480px) {
      .topbar input[type="text"],
      #buscar-usuario {
        font-size: 14px;
        width: 100%;
      }
      .header h1 { font-size: 18px; }
      .card p { font-size: 20px; }
    }
  </style>
</head>
<body class="dark-theme">
  <div class="dashboard-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="logo">C</div>
      <ul>
        <li><a href="#" data-target="dashboard-section">📊</a></li>
        <li><a href="#" data-target="profile-section">👤</a></li>
      </ul>
    </aside>

    <!-- Main Content -->
    <main class="dashboard-container">
      <!-- Topbar -->
      <header class="topbar">
        <button class="menu-toggle" onclick="toggleSidebar()">☰</button>
        <div class="topbar-actions">
          <div class="user-info">
            <span><%= adminName %></span>
            <img src="/images/Admin.png" alt="avatar" class="avatar" />
          </div>
        </div>
      </header>

      <!-- Sección Dashboard -->
      <section id="dashboard-section" class="main-section">
        <!-- Gráficas -->
        <div class="charts">
          <div class="chart-container">
            <h2>Monedas Distribuidas por Usuario</h2>
            <div id="wallet-chart" class="chart"></div>
          </div>
          <div class="chart-container">
            <h2>Promedio de Puntaje por Lección</h2>
            <div id="promedios-leccion-chart" class="chart"></div>
          </div>
        </div>

        <!-- Preguntas Más Falladas -->
        <div class="questions-section">
          <div class="card">
            <h2>Preguntas Más Falladas</h2>
            <label for="course-select">Selecciona un Curso:</label>
            <select id="course-select">
              <option value="0">Selecciona un curso</option>
              <option value="1">Curso 1</option>
              <option value="2">Curso 2</option>
              <option value="3">Curso 3</option>
            </select>
            <div id="questions-container">
              <!-- Aquí se mostrarán las preguntas dinámicamente -->
            </div>
          </div>
        </div>
      </section>

      <!-- Sección Perfil -->
      <section id="profile-section" class="main-section" style="display: none;">
        <h2>Usuarios</h2>

        <div class="summary-cards">
          <div class="card">
            <h2>Total Usuarios</h2>
            <p><%= totalUsuarios %></p>
          </div>
          <div class="card">
            <h2>Sesiones Activas Hoy</h2>
            <p><%= sesionesActivas %></p>
          </div>
        </div>

        <div class="usuarios-section">
          <div class="card">
            <h2>Lista de Usuarios</h2>
            <input type="text" id="buscar-usuario" placeholder="Buscar por nombre o email..." />
            <table id="usuarios-table" class="questions-table">
              <thead>
                <tr><th>ID</th><th>Nombre</th><th>Email</th><th>Fecha Nacimiento</th></tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script>
    const walletChartData = <%- JSON.stringify(walletChartData) %>;
    const promedioLeccionData = <%- JSON.stringify(promedioLeccionData) %>;
    const cursosConErrores = <%- JSON.stringify(cursosConErrores) %>;
    const usuarios = <%- JSON.stringify(usuarios) %>;

    function toggleSidebar() {
      document.querySelector('.sidebar').classList.toggle('show');
    }
  </script>

  <script src="/js/dashboardCharts.mjs" type="module"></script>
</body>
</html>
