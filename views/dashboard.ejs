<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard</title>
  <link rel="stylesheet" href="/css/dashboard.css" />
  <link rel="icon" type="image/png" href="/images/favicon.ico">
  <script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>
  <style>
    @media (max-width: 768px) {
      .sidebar { display: none; }
      .sidebar.show { display: flex; }
      .menu-toggle {
        background: none;
        border: none;
        color: white;
        font-size: 24px;
        cursor: pointer;
      }
    }

    @media (max-width: 480px) {
      .topbar input[type="text"],
      #buscar-usuario {
        font-size: 14px;
        width: 100%;
      }
      .header h1 { font-size: 18px; }
      .card p { font-size: 20px; }
    }
  </style>
</head>
<body class="dark-theme">
  <div class="dashboard-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="logo">C</div>
      <ul>
        <li><a href="#" data-target="dashboard-section">📊</a></li>
        <li><a href="#" data-target="profile-section">👤</a></li>
      </ul>
    </aside>

    <!-- Main Content -->
    <main class="dashboard-container">
      <!-- Topbar -->
      <header class="topbar">
        <button class="menu-toggle" onclick="toggleSidebar()" >☰</button>
        <div class="topbar-actions">
          <div class="user-info">
            <span><%= adminName %></span>
            <img src="/images/Admin.png" alt="avatar" class="avatar" />
          </div>
        </div>
      </header>

      <!-- Sección Dashboard -->
      <!-- Sección Dashboard -->
<section id="dashboard-section" class="main-section">
  <!-- Gráficas -->
  <div class="charts">
    <div class="chart-container">
      <h2>Coins Distributed per User</h2>
      <div id="wallet-chart" class="chart"></div>
    </div>
    <div class="chart-container">
      <h2>Average Score per Lesson</h2>
      <div id="promedios-leccion-chart" class="chart"></div>
    </div>
  </div>

  <!-- Preguntas Más Falladas -->
  <div class="questions-section">
    <div class="card">
      <h2>Most Failed Questions</h2>
      <label for="course-select">Select a Course:</label>
      <select id="course-select">
        <option value="0">Select a course</option>
        <option value="1">Course 1</option>
        <option value="2">Course 2</option>
        <option value="3">Course 3</option>
      </select>
      <div id="questions-container">
        <!-- Questions will be displayed dynamically here -->
      </div>
    </div>
  </div>
</section>

<!-- Sección Perfil -->
<section id="profile-section" class="main-section" style="display: none;">
  <h2>Users</h2>

  <div class="summary-cards">
    <div class="card">
      <h2>Total Users</h2>
      <p><%= totalUsuarios %></p>
    </div>
    <div class="card">
      <h2>Active Sessions Today</h2>
      <p><%= sesionesActivas %></p>
    </div>
  </div>

  <div class="usuarios-section">
    <div class="card">
      <h2>User List</h2>
      <input type="text" id="buscar-usuario" placeholder="Search by name or email..." />
      <table id="usuarios-table" class="questions-table">
        <thead>
          <tr><th>ID</th><th>Name</th><th>Email</th><th>Birth Date</th></tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</section>

    </main>
  </div>

  <script>
    const walletChartData = <%- JSON.stringify(walletChartData) %>;
    const promedioLeccionData = <%- JSON.stringify(promedioLeccionData) %>;
    const cursosConErrores = <%- JSON.stringify(cursosConErrores) %>;
    const usuarios = <%- JSON.stringify(usuarios) %>;

    function toggleSidebar() {
      document.querySelector('.sidebar').classList.toggle('show');
    }
  </script>

  <script src="/js/dashboardCharts.mjs" type="module"></script>
</body>
</html>
