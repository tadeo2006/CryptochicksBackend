<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard</title>
  <link rel="stylesheet" href="/css/dashboard.css" />
  <script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>
</head>
<body class="dark-theme">
  <div class="dashboard-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="logo">C</div>
      <ul>
        <li><a href="#" data-target="dashboard-section">📊</a></li>
        <li><a href="#" data-target="profile-section">👤</a></li>
        <li><a href="#" data-target="settings-section">⚙️</a></li>
      </ul>
    </aside>

    <!-- Main Content -->
    <main class="dashboard-container">
      <!-- Topbar -->
      <header class="topbar">
        <div class="topbar-actions">
          <div class="user-info">
            <span><%= adminName %></span>
            <img src="/images/Admin.png" alt="avatar" class="avatar" />
          </div>
        </div>
      </header>

      <!-- Sección del Dashboard -->
      <section id="dashboard-section" class="main-section">
        <!-- Gráficas -->
        <section class="charts">
          <div class="chart-container">
            <h2>Monedas Distribuidas por Usuario</h2>
            <div id="wallet-chart" class="chart"></div>
          </div>
          <div class="chart-container">
            <h2>Promedio de Puntaje por Lección</h2>
            <div id="promedios-leccion-chart" class="chart"></div>
          </div>
        </section>

        <!-- Preguntas Más Falladas por Curso -->
        <section class="questions-section">
          <div class="card">
            <h2>Preguntas Más Falladas</h2>
            <label for="course-select">Selecciona un Curso:</label>
            <select id="course-select">
              <option value="1">Curso 1</option>
              <option value="2">Curso 2</option>
              <option value="3">Curso 3</option>
            </select>

            <div id="questions-container">
              <!-- Contenedores para las tablas de cada lección -->
              <div id="leccion-1" class="leccion-table">
                <h3>Lección 1</h3>
                <table class="questions-table">
                  <thead>
                    <tr>
                      <th>Pregunta</th>
                      <th>Errores</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
              <div id="leccion-2" class="leccion-table">
                <h3>Lección 2</h3>
                <table class="questions-table">
                  <thead>
                    <tr>
                      <th>Pregunta</th>
                      <th>Errores</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      </section>

      <!-- Sección de Perfil -->
      <section id="profile-section" class="main-section" style="display: none;">
        <h2>Usuarios</h2>
                <!-- Summary Cards -->
        <section class="summary-cards">
          <div class="card">
            <h2>Total Usuarios</h2>
            <p><%= totalUsuarios %></p>
          </div>
  
          <div class="card">
            <h2>Sesiones Activas Hoy</h2>
            <p><%= sesionesActivas %></p>
          </div>
  
        <!-- Lista de Usuarios -->
        <section class="usuarios-section" >
          <div class="card">
            <h2>Lista de Usuarios</h2>
  
            <input
              type="text"
              id="buscar-usuario"
              placeholder="Buscar por nombre o email..."
              style="width: 100%; padding: 8px; margin-bottom: 12px; border-radius: 5px; border: 1px solid #ccc;"
            />   
            
            <table id="usuarios-table" class="questions-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Nombre</th>
                  <th>Email</th>
                  <th>Fecha Nacimiento</th>

                </tr>
              </thead>
              <tbody>
                <!-- Se llena con JavaScript -->
              </tbody>
            </table>
          </div>
          
        </section>
  

  
          
         
      </section>

      <!-- Sección de Configuración -->
      
      </section>
    </main>
  </div>

  <!-- Variables para el JS -->
  <script>
    const walletChartData = <%- JSON.stringify(walletChartData) %>;
    const promedioLeccionData = <%- JSON.stringify(promedioLeccionData) %>;
    const cursosConErrores = <%- JSON.stringify(cursosConErrores) %>;
    const usuarios = <%- JSON.stringify(usuarios) %>;
  </script>

  <script src="/js/dashboardCharts.mjs" type="module"></script>
</body>
</html>
