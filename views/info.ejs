<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About the Game | CryptoChicks Game</title>
  <link rel="stylesheet" href="/css/info.css">
  <link rel="icon" type="image/png" href="/images/favicon.ico" >
</head>
<body>
  <!--<header class="topbar">-->
  <!--  <div class="logo">-->
  <!--    <img src="/images/logo.png" alt="CryptoChicks Logo">-->
  <!--  </div>-->
  <!--  <nav>-->
  <!--    <button onclick="location.href='/'">Home</button>-->
  <!--    <button onclick="location.href='/login'">Log In</button>-->
  <!--  </nav>-->
  <!--</header>-->
  <div class="animated-background">
    <img src="/images/BG.png" alt="Background 1" class="background-image">
  </div>

  <header class="waybar">
    <div class="logo">
      <img src="/images/logo.png" alt="CryptoChicks Logo">
    </div>
    <nav class="navbar">
      <div class="menu-toggle" id="menu-toggle">&#9776;</div>
      <div class="nav-buttons" id="nav-buttons">
        <button onclick="location.href='/'">Home</button>
        <button onclick="location.href='/login'">Log In</button>
        <button onclick="location.href='/signup'">Sign Up</button>
      </div>
    </nav>
  </header>

  <main class="info-content">
    <section class="intro">
      <h1>What is CryptoChicks Quest?</h1>
      <p>CryptoChicks Quest is an interactive adventure designed to help women and young people discover the world of technology, artificial intelligence, and cryptocurrencies in a fun and educational way.</p>
    </section>

    <section class="features">
      <div class="feature">
        <img src="/images/criptoBIT.jpg" alt="Cryptocurrencies">
        <h2>Cryptocurrencies</h2>
        <p>Learn the basics of digital currencies, blockchain, and financial security.</p>
      </div>
      <div class="feature">
        <img src="/images/IA.jpg" alt="AI">
        <h2>Artificial Intelligence</h2>
        <p>Discover how AI is changing the world and learn to use it as a creative tool.</p>
      </div>
      <div class="feature">
        <img src="/images/chicks.jpg" alt="Chicks">
        <h2>Educational Game</h2>
        <p>Participate in challenges, earn rewards, and unlock content while you learn.</p>
      </div>
    </section>

    <section class="cta">
      <h2>Join the educational revolution</h2>
      <p>Be part of a community that believes in the power of knowledge, equity, and technology.</p>
      <button onclick="location.href='/signup'">Sign Up Now</button>
    </section>
  </main>

  <footer>
    <p>&copy; 2025 CryptoChicks – Learning through play with technology</p>
    <p>This application was developed by students from Tec de Monterrey in collaboration with CryptoChicks.</p>
  </footer>

  <script>
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('nav-buttons');

    toggle.addEventListener('click', () => {
      nav.classList.toggle('show');
    });

    // Optional: close on button click
    document.querySelectorAll('#nav-buttons button').forEach(btn => {
      btn.addEventListener('click', () => {
        nav.classList.remove('show');
      });
    });
  </script>
</body>
</html>

