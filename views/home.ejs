<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CryptoChicks Quest</title>
  <link rel="stylesheet" href="/css/home.css">
  <link rel="icon" type="image/png" href="/images/favicon.ico" >
</head>

<body>
  <div class="animated-background">
    <img src="/images/BG.png" alt="Fondo 1" class="background-image">
    <img src="/images/CryptoChickGlobo.gif" alt="AnimacionCryptoChick" class="gif-animado">

  </div>

  <header class="waybar">
    <div class="logo">
      <img src="/images/logo.png" alt="CryptoChicks Logo">
    </div>
    <nav class="navbar">
      <div class="menu-toggle" id="menu-toggle">&#9776;</div>
      <div class="nav-buttons" id="nav-buttons">
        <button onclick="location.href='/login'">Iniciar Sesión</button>
        <button onclick="location.href='/info'">Sobre el juego</button>
        <button onclick="location.href='/signup'">Regístrate</button>
      </div>
    </nav>
  </header>

  <main class="hero">
    <div class="content">
      <h1>CryptoChicks Quest</h1>
      <p>Un juego educativo que empodera a las mujeres mediante el aprendizaje de tecnologías como Inteligencia Artificial y Criptomonedas.</p>
      <div class="buttons">
        <button class="juega" onclick="location.href='/play'">¡Juega Ahora!</button>
        <button class="registro" onclick="location.href='/signup'">Regístrate</button>
      </div>
    </div>
  </main>

  <footer>
    <p>&copy; 2025 CryptoChicks - Aprendiendo jugando con tecnología</p>
    <p>Esta aplicación fue desarrollada por alumnos del Tec de Monterrey como colaboración con CryptoChicks</p>
  </footer>

  <script>
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('nav-buttons');

    toggle.addEventListener('click', () => {
      nav.classList.toggle('show');
    });

    // Opcional: cerrar al hacer clic en un botón
    document.querySelectorAll('#nav-buttons button').forEach(btn => {
      btn.addEventListener('click', () => {
        nav.classList.remove('show');
      });
    });
  </script>

</body>
</html>
